# FAOSTAT MCP Server — Environment Variables
# Copy this file to .env and fill in your values.
# Get your token and credentials from the FAOSTAT developer portal:
# https://www.fao.org/faostat/en/#developer-portal

# --- Required (username+password recommended, OR a token) ---

# Username and password: used to obtain and refresh tokens automatically
FAOSTAT_USERNAME=
FAOSTAT_PASSWORD=

# Or an API token from the developer portal (expires after 1 hour, no auto-refresh)
FAOSTAT_API_TOKEN=

# --- Redis (optional) caching default server parameters ---

REDIS_HOST_IP_ADDRESS="127.0.0.1"
REDIS_HOST_PORT_NUMBER="6379"
REDIS_DATABASE="0"

REDIS_USERNAME=
REDIS_PASSWORD=

# --- Default caching TTL (time to live) configuration ---

MEM_CACHE_TTL="1200"
REDIS_CACHE_TTL="1800"
MAX_MEM_CACHE_SIZE="256"

# --- Disk cache (SQLite, cross-session persistence) ---
# Set FAOSTAT_DISK_CACHE=false to disable entirely (e.g. read-only filesystems)
FAOSTAT_DISK_CACHE="true"

# How long disk-cached responses are valid (seconds). Default 24h — FAOSTAT data updates daily.
DISK_CACHE_TTL="86400"

# Maximum number of entries stored on disk before the oldest are evicted (LRU).
DISK_CACHE_MAX_ENTRIES="1000"

# --- Nice to have  ---

# Base URL for the FAOSTAT API (default: https://faostatservices.fao.org/api/v1)
FAOSTAT_BASE_URL=https://faostatservices.fao.org/api/v1

# Default language for API responses (default: en)
FAOSTAT_DEFAULT_LANG=en

# Set to 1 to stop the once-per-session PyPI check for a newer faostat-mcp release
# FAOSTAT_NO_UPDATE_CHECK=1
