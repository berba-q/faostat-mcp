{
  "_comment": "Use 'faostat' (uvx) after installing via pip. Use 'faostat-dev' if running from a cloned repo.",
  "mcpServers": {
    "faostat": {
      "_comment": "Recommended: install via 'pip install faostat-mcp' or 'uvx faostat-mcp'",
      "command": "uvx",
      "args": ["faostat-mcp"],
      "env": {
        "FAOSTAT_USERNAME": "your_email",
        "FAOSTAT_PASSWORD": "your_password",
        "FAOSTAT_BASE_URL": "https://faostatservices.fao.org/api/v1",
        "FAOSTAT_DEFAULT_LANG": "en"
      }
    },
    "faostat-dev": {
      "_comment": "Development mode: run from a cloned repo with 'pip install -e .'",
      "command": "python",
      "args": ["-m", "faostat_mcp.server"],
      "cwd": "/path/to/faostat-mcp",
      "env": {
        "FAOSTAT_USERNAME": "your_email",
        "FAOSTAT_PASSWORD": "your_password",
        "FAOSTAT_BASE_URL": "https://faostatservices.fao.org/api/v1",
        "FAOSTAT_DEFAULT_LANG": "en"
      }
    }
  }
}
